# ==============================================================================
# Auto-Meds Environment Configuration Template
# Copy this file to '.env' and populate with your secure, environment-specific values.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/automeds
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# Docker PostgreSQL Service Configuration
POSTGRES_DB=automeds
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_here

# Liquibase Database Migrations (Enabled by default)
SPRING_LIQUIBASE_ENABLED=true

# CORS Configuration (Set to your AWS Public IP, custom domain, or * for open)
# Example: CORS_ALLOWED_ORIGINS=http://54.210.12.34,https://my-automeds.duckdns.org
CORS_ALLOWED_ORIGINS=*

# JWT Signing Secret (Minimum 256-bit / 32-byte cryptographically secure random string)
# Example generation: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Spring Mail SMTP Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_email_password

# Twilio SMS Service Configuration (Optional)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here
TWILIO_WEBHOOK_TOKEN=your_secure_random_webhook_token_here

# NVIDIA Nemotron-3.5 Parse AI Engine (Clinical Document Layout, Tables & OCR)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-parse
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
